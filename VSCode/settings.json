{
    "__comment": "TODO: Below this line are manual customizations by TimTr **",    


    "editor.fontFamily": "BlexMono Nerd Font, SF Mono, Menlo, 'Courier New', monospace",
    "window.systemColorTheme": "dark",
    "breadcrumbs.enabled": false,

    "window.zoomLevel": 1,
    "workbench.sideBar.location": "left",
    "workbench.fontAliasing": "antialiased",
    "workbench.editor.enablePreview": false,
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "none",
    "window.zoomPerWindow": false,
    "workbench.experimental.modernUIUppercaseViewHeaders": true,
    "workbench.tree.enableStickyScroll": false,

    "editor.minimap.enabled": false,
    "editor.showFoldingControls": "never",
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "none",
    "editor.guides.indentation": false,
    "editor.guides.highlightActiveIndentation": false,
    "editor.occurrencesHighlight": "off",
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.selectionHighlight": false,
    "editor.fontWeight": "normal",
    "editor.lineNumbers": "on",
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.fontSize": 13,

    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.enableFileLinks": "notRemote",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "terminal.integrated.letterSpacing": 1,
    "terminal.integrated.lineHeight": 1.1,
    "terminal.integrated.smoothScrolling": true,

    "explorer.sortOrder": "foldersNestsFiles",
    "explorer.sortOrderLexicographicOptions": "upper",
    "explorer.compactFolders": false,
    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": true,

    "files.exclude": {
        "**/.build": true,
        "**/.swiftpm": true,
        "**/.vscode": true,
        "**/.*": true
    },
    "files.associations": {
        ".profile.local": "shellscript",
        "*.txt": "markdown",
    },

    "git.openRepositoryInParentFolders": "always",
    "git.autofetch": true,
    "githubPullRequests.fileListLayout": "tree",
    "githubPullRequests.useReviewMode": "auto",

    "diffEditor.ignoreTrimWhitespace": true,

    "lldb.suppressUpdateNotifications": true,
    "lldb.library": "/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB",
    "lldb.launch.expressions": "native",

    "github.copilot.nextEditSuggestions.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "claudeCode.preferredLocation": "panel",
    "http.systemCertificatesNode": true,
    "geminicodeassist.agentDebugMode": true,
    "geminicodeassist.outlines.automaticOutlineGeneration": true,

    "claudeCode.useTerminal": true,
    "editor.inlineSuggest.edits.showLongDistanceHint": false,
    "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
    "chat.disableAIFeatures": true,



    "editor.tokenColorCustomizations": {
        "comments": "#4f5761",
        "strings": "#00f900",
        "keywords": "#ff6a00",
        "functions": "#65b1cb",
        "numbers": "#2f00ff",
        "types": "#e3d74b",
        "variables": "#8c00ff", 

        "textMateRules": [
            {
                "scope": "comment",
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "support.type.property-name.json",
                    "entity.name.tag.html"
                ],
                "settings": {
                    "foreground": "#00f900",
                }              
            },
            {
                "scope": [
                    "entity.name.command.shell",
                    "support.function.any-method.swift",
                    "keyword.control.public.swift"
                ],
                "settings": {
                    "foreground": "#6686de"
                }
            },
            {
                "scope": [
                    "meta.definition.type.body.swift"
                ],
                "settings": {
                    "foreground": "#a0b3bb"
                }
            },            
            {
                "scope": [
                    "entity.name.type.struct.swift",
                ],
                "settings": {
                    "foreground": "#e63ede"
                }
            },
            {
                "scope": "heading.1.markdown entity.name.section.markdown, heading.1.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#ff6a00",
                    "fontStyle": "italic bold",
                }
            },
            {
                "scope": "heading.2.markdown entity.name.section.markdown, heading.2.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#ff6a00",
                    "fontStyle": "bold",
                }
            },
            {
                "scope": "heading.3.markdown entity.name.section.markdown, heading.3.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#ff6a00",
                    "fontStyle": "italic",
                }
            },    
            {
                "scope": "heading.4.markdown entity.name.section.markdown, heading.4.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#ff6a00",
                    "fontStyle": "italic",
                }
            },
            {
                "scope": "markup.underline.link.markdown",
                "settings": { 
                    "fontStyle": "italic",
                    "foreground": "#1bc4de",
                }
            },
            { "scope": "punctuation.definition.list.begin.markdown", "settings": { "foreground": "#FFED9D", }
            },
            { "scope": "entity.name.section.markdown", "settings": { "fontStyle": "bold underline", }
            },
            {
                "scope": "string.other.link.title.markdown", 
                "settings": {
                    "foreground": "#d1dc53",
                    "fontStyle": "italic",
                }
            },
            {
                "scope": "punctuation.definition.metadata.markdown",
                "settings": {
                    "foreground": "#e761dc",
                }
            },
            {
                "scope": [
                    "entity.name.type.class.swift",
                ],
                "settings": {
                    "foreground": "#b244d7"
                }
            }
            
        ]
    },
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "class": {
                "foreground": "#ff9999"
            }
        }
    },
